 "sentences": [
  {
   "start": 0.4,
   "end": 4.8100000000000005,
   "text": "If every drop of water on Earth vanished, you wouldn't survive it."
  },
  {
   "start": 5.3100000000000005,
   "end": 12.24,
   "text": "Up to sixty percent of an adult's body is water, so every person, animal and plant would instantly shrivel."
  },
  {
   "start": 13.55,
   "end": 17.939999999999998,
   "text": "The oceans would leave basins averaging about three point seven kilometers deep."
  },
  {
   "start": 18.32,
   "end": 19.619999999999997,
   "text": "Clouds would disappear."
  },
  {
   "start": 19.99,
   "end": 24.7,
   "text": "And water vapor is Earth's biggest heat trapper, about half the greenhouse effect."
  },
  {
   "start": 25.049999999999997,
   "end": 30.13,
   "text": "Without it, far more heat would escape into space every night, like a desert everywhere."
  },
  {
   "start": 30.59,
   "end": 31.849999999999998,
   "text": "Here's the strange part."
  },
  {
   "start": 32.19,
   "end": 37.800000000000004,
   "text": "Rolled into one ball, all that water would be under 1,400 kilometers wide."
  },
  {
   "start": 38.13,
   "end": 40.940000000000005,
   "text": "A planet nine times wider depends on it."
  },
  {
   "start": 41.22,
   "end": 44.17,
   "text": "Subscribe so you never miss the next what-if."
  }
 ],
