 "sentences": [
  {
   "start": 0.4,
   "end": 0.826,
   "text": "Meet Ray."
  },
  {
   "start": 1.326,
   "end": 4.504,
   "text": "He wakes up, and every other person on Earth is gone."
  },
  {
   "start": 5.004,
   "end": 7.106,
   "text": "\"Finally, no traffic,\" he says."
  },
  {
   "start": 7.606,
   "end": 12.062,
   "text": "Soon the lights go out, because power plants shut themselves down when nobody runs them."
  },
  {
   "start": 12.562,
   "end": 18.068,
   "text": "Under New York, the subway pumps stop, and one estimate says the tunnels flood in about two days."
  },
  {
   "start": 18.568,
   "end": 22.385,
   "text": "Ray stocks up on cans, which keep their best quality for two to five years."
  },
  {
   "start": 22.885,
   "end": 24.162,
   "text": "Food isn't his problem."
  },
  {
   "start": 24.662,
   "end": 25.513,
   "text": "Loneliness is."
  },
  {
   "start": 26.013,
   "end": 32.609,
   "text": "Being cut off from people raises the risk of early death about as much as smoking up to fifteen cigarettes a day."
  },
  {
   "start": 33.109,
   "end": 35.211,
   "text": "\"Okay,\" Ray says, \"I miss traffic.\""
  },
  {
   "start": 35.711,
   "end": 36.987,
   "text": "Subscribe for more what-ifs."
  }
 ],
