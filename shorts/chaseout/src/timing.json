 "sentences": [
  {
   "start": 0.4,
   "end": 3.591,
   "text": "Picture your boss walking you past your desk to a tiny room."
  },
  {
   "start": 4.091,
   "end": 4.943,
   "text": "No computer."
  },
  {
   "start": 5.443,
   "end": 5.868,
   "text": "No work."
  },
  {
   "start": 6.368,
   "end": 9.972,
   "text": "Just a ticking clock, and a man in the corner with his feet up."
  },
  {
   "start": 10.472,
   "end": 12.787,
   "text": "Your new job, your boss says, is nothing."
  },
  {
   "start": 13.287,
   "end": 14.351,
   "text": "Sit here until six."
  },
  {
   "start": 14.851,
   "end": 16.766,
   "text": "At first it feels like a holiday."
  },
  {
   "start": 17.266,
   "end": 18.755,
   "text": "Then co-workers start staring."
  },
  {
   "start": 19.255,
   "end": 20.106,
   "text": "The emails stop."
  },
  {
   "start": 20.606,
   "end": 23.16,
   "text": "Your old desk has someone else's photos on it."
  },
  {
   "start": 23.66,
   "end": 28.102,
   "text": "Every Friday your boss leans in, smiling, to ask how you're enjoying your new role."
  },
  {
   "start": 28.602,
