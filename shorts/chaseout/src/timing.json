 "chunks": [
  {
   "text": "Picture your boss",
   "w0": 0,
   "w1": 2,
   "start": 0.4,
   "end": 1.251
  },
  {
   "text": "walking you past your desk",
   "w0": 3,
   "w1": 7,
   "start": 1.251,
   "end": 2.528
  },
  {
   "text": "to a tiny room.",
   "w0": 8,
   "w1": 11,
   "start": 2.528,
   "end": 3.591
  },
  {
   "text": "No computer.",
   "w0": 12,
   "w1": 13,
   "start": 4.091,
   "end": 4.943
  },
  {
   "text": "No work.",
   "w0": 14,
   "w1": 15,
   "start": 5.443,
   "end": 5.868
  },
  {
   "text": "Just a ticking clock,",
   "w0": 16,
   "w1": 19,
   "start": 6.368,
   "end": 7.432
  },
  {
   "text": "and a man in the corner",
   "w0": 20,
   "w1": 25,
   "start": 7.632,
   "end": 9.121
  },
  {
   "text": "with his feet up.",
   "w0": 26,
   "w1": 29,
   "start": 9.121,
   "end": 9.972
  },
  {
   "text": "Your new job,",
   "w0": 30,
   "w1": 32,
   "start": 10.472,
   "end": 11.111
  },
  {
   "text": "your boss says,",
   "w0": 33,
   "w1": 35,
   "start": 11.311,
   "end": 11.949
  },
  {
   "text": "is nothing.",
   "w0": 36,
   "w1": 37,
   "start": 12.149,
   "end": 12.787
  },
  {
   "text": "Sit here until six.",
   "w0": 38,
   "w1": 41,
   "start": 13.287,
   "end": 14.351
  },
  {
   "text": "At first",
   "w0": 42,
   "w1": 43,
   "start": 14.851,
   "end": 15.277
  },
  {
   "text": "it feels like a holiday.",
   "w0": 44,
   "w1": 48,
   "start": 15.277,
   "end": 16.766
  },
  {
   "text": "Then co-workers",
   "w0": 49,
   "w1": 50,
   "start": 17.266,
   "end": 18.117
  },
  {
   "text": "start staring.",
   "w0": 51,
   "w1": 52,
   "start": 18.117,
   "end": 18.755
  },
  {
   "text": "The emails stop.",
   "w0": 53,
   "w1": 55,
   "start": 19.255,
   "end": 20.106
  },
  {
   "text": "Your old desk",
   "w0": 56,
   "w1": 58,
   "start": 20.606,
   "end": 21.245
  },
  {
   "text": "has someone else's photos on it.",
   "w0": 59,
   "w1": 64,
   "start": 21.245,
   "end": 23.16
  },
  {
   "text": "Every Friday",
   "w0": 65,
   "w1": 66,
   "start": 23.66,
   "end": 24.511
  },
  {
   "text": "your boss leans in, smiling,",
   "w0": 67,
   "w1": 71,
   "start": 24.511,
   "end": 25.987
  },
  {
   "text": "to ask how you're enjoying",
   "w0": 72,
   "w1": 76,
   "start": 26.187,
   "end": 27.464
  },
  {
   "text": "your new role.",
   "w0": 77,
   "w1": 79,
   "start": 27.464,
   "end": 28.102
  },
  {
   "text": "The man in the corner",
   "w0": 80,
   "w1": 84,
   "start": 28.602,
   "end": 29.879
  },
  {
   "text": "has been here for years,",
   "w0": 85,
   "w1": 89,
   "start": 29.879,
   "end": 30.943
  },
  {
   "text": "so you put your feet up too.",
   "w0": 90,
   "w1": 96,
   "start": 31.143,
   "end": 32.632
  },
  {
   "text": "Then one Monday,",
   "w0": 97,
   "w1": 99,
   "start": 33.132,
   "end": 33.983
  },
  {
   "text": "his chair is empty",
