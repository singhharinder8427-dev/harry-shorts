 "chunks": [
  {
   "text": "Picture your boss",
   "w0": 0,
   "w1": 2,
   "start": 0.4,
   "end": 1.4100000000000001
  },
  {
   "text": "walking you past your desk",
   "w0": 3,
   "w1": 7,
   "start": 1.4100000000000001,
   "end": 2.86
  },
  {
   "text": "to a tiny room.",
   "w0": 8,
   "w1": 11,
   "start": 2.86,
   "end": 3.96
  },
  {
   "text": "No computer.",
   "w0": 12,
   "w1": 13,
   "start": 4.4,
   "end": 5.17
  },
  {
   "text": "No work.",
   "w0": 14,
   "w1": 15,
   "start": 5.430000000000001,
   "end": 6.010000000000001
  },
  {
   "text": "Just a ticking clock,",
   "w0": 16,
   "w1": 19,
   "start": 6.41,
   "end": 7.61
  },
  {
   "text": "and a man in the corner",
   "w0": 20,
   "w1": 25,
   "start": 7.760000000000001,
   "end": 8.73
  },
  {
   "text": "with his feet up.",
   "w0": 26,
   "w1": 29,
   "start": 8.73,
   "end": 9.530000000000001
  },
  {
   "text": "Your new job,",
   "w0": 30,
   "w1": 32,
   "start": 10.120000000000001,
   "end": 10.94
  },
  {
   "text": "your boss says,",
   "w0": 33,
   "w1": 35,
   "start": 10.94,
   "end": 11.83
  },
  {
   "text": "is nothing.",
   "w0": 36,
   "w1": 37,
   "start": 12.0,
   "end": 12.67
  },
  {
   "text": "Sit here until six.",
   "w0": 38,
   "w1": 41,
   "start": 13.030000000000001,
   "end": 14.19
  },
  {
   "text": "At first",
   "w0": 42,
   "w1": 43,
   "start": 14.950000000000001,
   "end": 15.5
  },
  {
   "text": "it feels like a holiday.",
   "w0": 44,
   "w1": 48,
   "start": 15.5,
   "end": 16.66
  },
  {
   "text": "Then co-workers",
   "w0": 49,
   "w1": 50,
   "start": 17.15,
   "end": 18.27
  },
  {
   "text": "start staring.",
   "w0": 51,
   "w1": 52,
   "start": 18.27,
   "end": 19.139999999999997
  },
  {
   "text": "The emails stop.",
   "w0": 53,
   "w1": 55,
   "start": 19.54,
   "end": 20.54
  },
  {
   "text": "Your old desk",
   "w0": 56,
   "w1": 58,
   "start": 20.9,
   "end": 21.58
  },
  {
   "text": "has someone else's photos on it.",
   "w0": 59,
   "w1": 64,
   "start": 21.58,
   "end": 23.139999999999997
  },
  {
   "text": "Every Friday",
   "w0": 65,
   "w1": 66,
   "start": 23.68,
   "end": 24.47
  },
  {
   "text": "your boss leans in, smiling,",
   "w0": 67,
   "w1": 71,
   "start": 24.47,
   "end": 26.459999999999997
  },
  {
   "text": "to ask how you're enjoying",
   "w0": 72,
   "w1": 76,
   "start": 26.65,
   "end": 27.72
  },
  {
   "text": "your new role.",
   "w0": 77,
   "w1": 79,
   "start": 27.72,
   "end": 28.41
  },
  {
   "text": "The man in the corner",
   "w0": 80,
   "w1": 84,
   "start": 29.049999999999997,
   "end": 29.9
  },
  {
   "text": "has been here for years,",
   "w0": 85,
   "w1": 89,
   "start": 29.9,
   "end": 31.16
  },
  {
   "text": "so you put your feet up too.",
   "w0": 90,
   "w1": 96,
   "start": 31.34,
   "end": 32.94
  },
  {
   "text": "Then one Monday,",
   "w0": 97,
   "w1": 99,
   "start": 33.5,
   "end": 34.73
  },
  {
   "text": "his chair is empty",
   "w0": 100,
   "w1": 103,
   "start": 34.96,
   "end": 36.03
  },
  {
   "text": "and his desk is cleared.",
   "w0": 104,
   "w1": 108,
   "start": 36.24,
   "end": 37.49
  },
  {
   "text": "In Japan,",
   "w0": 109,
   "w1": 110,
   "start": 38.22,
   "end": 38.89
  },
  {
   "text": "firing someone",
   "w0": 111,
   "w1": 112,
   "start": 38.89,
   "end": 39.73
  },
  {
   "text": "without a strong reason",
   "w0": 113,
   "w1": 116,
   "start": 39.73,
   "end": 40.89
  },
  {
   "text": "is very hard.",
   "w0": 117,
   "w1": 119,
   "start": 40.89,
   "end": 41.94
  },
  {
   "text": "So some companies",
   "w0": 120,
   "w1": 122,
   "start": 42.25,
   "end": 43.309999999999995
  },
  {
   "text": "take away the work,",
   "w0": 123,
   "w1": 126,
   "start": 43.309999999999995,
   "end": 44.29
  },
  {
   "text": "and wait for you to leave.",
   "w0": 127,
   "w1": 132,
   "start": 44.48,
   "end": 45.65
  },
  {
   "text": "Japan calls them",
   "w0": 133,
   "w1": 135,
   "start": 46.16,
   "end": 47.07
  },
  {
   "text": "chase-out rooms.",
   "w0": 136,
   "w1": 137,
   "start": 47.199999999999996,
   "end": 48.22
  },
  {
   "text": "Subscribe for more",
   "w0": 138,
   "w1": 140,
   "start": 48.73,
   "end": 49.64
  },
  {
   "text": "strange facts like this.",
   "w0": 141,
   "w1": 144,
   "start": 49.64,
   "end": 51.05
  }
 ],
 "sentences": [
  {
   "start": 0.4,
   "end": 3.96,
   "text": "Picture your boss walking you past your desk to a tiny room."
  },
  {
   "start": 4.4,
   "end": 5.17,
   "text": "No computer."
  },
  {
   "start": 5.430000000000001,
   "end": 6.010000000000001,
   "text": "No work."
  },
  {
   "start": 6.41,
   "end": 9.530000000000001,
   "text": "Just a ticking clock, and a man in the corner with his feet up."
  },
  {
   "start": 10.120000000000001,
   "end": 12.67,
   "text": "Your new job, your boss says, is nothing."
  },
  {
   "start": 13.030000000000001,
   "end": 14.19,
   "text": "Sit here until six."
  },
  {
   "start": 14.950000000000001,
   "end": 16.66,
   "text": "At first it feels like a holiday."
  },
  {
   "start": 17.15,
   "end": 19.139999999999997,
   "text": "Then co-workers start staring."
  },
  {
   "start": 19.54,
   "end": 20.54,
   "text": "The emails stop."
  },
  {
   "start": 20.9,
   "end": 23.139999999999997,
   "text": "Your old desk has someone else's photos on it."
  },
  {
   "start": 23.68,
   "end": 28.41,
   "text": "Every Friday your boss leans in, smiling, to ask how you're enjoying your new role."
  },
