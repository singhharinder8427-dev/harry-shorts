 "sentences": [
  {
   "start": 0.4,
   "end": 2.94,
   "text": "Throw something away, and it doesn't vanish."
  },
  {
   "start": 3.44,
   "end": 5.781,
   "text": "The town's trash piles into a stinking mountain."
  },
  {
   "start": 6.281,
   "end": 8.396,
   "text": "Burn it outside, and the sky turns black."
  },
  {
   "start": 8.896,
   "end": 14.84,
   "text": "So a crane drops it into a closed furnace, where it tumbles down a moving grate as air from below burns it."
  },
  {
   "start": 15.34,
   "end": 17.681,
   "text": "The heat boils water in pipes lining the walls."
  },
  {
   "start": 18.181,
   "end": 21.998,
   "text": "That steam spins a turbine for power, and leftover heat can warm homes."
  },
  {
   "start": 22.498,
   "end": 28.643,
   "text": "Lime neutralizes acid in the smoke, carbon traps mercury and dioxins, and fabric bags catch the dust."
  },
  {
   "start": 29.143,
   "end": 32.121,
   "text": "The white plume from the chimney is mostly water vapor."
  },
  {
   "start": 32.621,
   "end": 36.438,
   "text": "Magnets pull metal from the ash, and the rest can become road gravel."
  },
  {
   "start": 36.938,
   "end": 39.279,
   "text": "Subscribe to see how more everyday things work."
  }
 ],
