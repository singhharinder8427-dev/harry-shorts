 "sentences": [
  {
   "start": 0.4,
   "end": 1.889,
   "text": "Why can't you tickle yourself?"
  },
  {
   "start": 2.389,
   "end": 4.917,
   "text": "Same fingers, same spot, and nothing happens."
  },
  {
   "start": 5.417,
   "end": 7.332,
   "text": "Your brain is one step ahead of you."
  },
  {
   "start": 7.832,
   "end": 13.564,
   "text": "Every time you move, it keeps a copy of the command and predicts exactly what you're about to feel."
  },
  {
   "start": 14.064,
   "end": 19.37,
   "text": "Your cerebellum sends that prediction ahead, and the touch is turned down before it arrives."
  },
  {
   "start": 19.87,
   "end": 22.423,
   "text": "Scientists in London tested it with robots."
  },
  {
   "start": 22.923,
   "end": 28.868,
   "text": "When people moved one robot arm and another touched their palm at the same moment, it hardly tickled."
  },
  {
   "start": 29.368,
   "end": 33.185,
   "text": "Add a delay of a fifth of a second, and the tickle came back."
  },
  {
   "start": 33.685,
   "end": 37.302,
   "text": "Your brain only lets you feel a tickle when it can't see it coming."
  },
  {
   "start": 37.802,
   "end": 40.143,
   "text": "Subscribe for more strange facts about your body."
  }
 ],
