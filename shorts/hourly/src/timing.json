   "start": 14.289,
   "end": 16.191
  },
  {
   "text": "Feels like a rigged game, right?",
   "w0": 41,
   "w1": 46,
   "start": 16.691,
   "end": 18.168
  },
  {
   "text": "It isn't.",
   "w0": 47,
   "w1": 48,
   "start": 18.668,
   "end": 19.306
  },
  {
   "text": "You're using the wrong equation.",
