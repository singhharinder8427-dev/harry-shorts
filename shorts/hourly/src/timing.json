 "sentences": [
  {
   "start": 0.4,
   "end": 5.068,
   "text": "At twenty dollars an hour, a million dollars takes you twenty-four years of work."
  },
  {
   "start": 5.568,
   "end": 7.47,
   "text": "That's full time, saving every cent."
  },
  {
   "start": 7.97,
   "end": 9.672,
   "text": "Pay your taxes: twenty-eight years."
  },
  {
   "start": 10.172,
   "end": 13.789,
   "text": "Pay rent and save a normal twenty percent: a hundred and forty."
  },
  {
   "start": 14.289,
   "end": 16.191,
   "text": "Meanwhile, prices roughly double."
  },
  {
   "start": 16.691,
   "end": 18.168,
   "text": "Feels like a rigged game, right?"
  },
  {
   "start": 18.668,
   "end": 19.306,
   "text": "It isn't."
  },
  {
   "start": 19.806,
   "end": 21.509,
   "text": "You're using the wrong equation."
  },
  {
   "start": 22.009,
   "end": 24.974,
   "text": "Salary is time times rate, and both have a ceiling."
  },
  {
   "start": 25.474,
   "end": 29.93,
   "text": "The other equation is problems solved times people reached, and it has no ceiling."
  },
  {
   "start": 30.43,
   "end": 33.834,
   "text": "A yoga teacher at a hundred dollars an hour still sells hours."
  },
  {
   "start": 34.334,
   "end": 36.662,
   "text": "Film the class once, and thousands can buy it."
  },
  {
   "start": 37.162,
   "end": 38.226,
   "text": "The game isn't rigged."
  },
  {
   "start": 38.726,
   "end": 40.428,
   "text": "You were just taught half the rules."
  },
  {
   "start": 40.928,
   "end": 42.417,
   "text": "Subscribe for the other half."
  }
 ],
