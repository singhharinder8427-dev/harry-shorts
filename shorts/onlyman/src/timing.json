 "sentences": [
  {
   "start": 0.4,
   "end": 0.826,
   "text": "Meet Ray."
  },
  {
   "start": 1.326,
   "end": 4.079,
   "text": "One morning, every other man on Earth is gone."
  },
  {
   "start": 4.579,
   "end": 6.906,
   "text": "\"So I'm kind of a big deal now,\" he says."
  },
  {
   "start": 7.406,
   "end": 9.321,
   "text": "His sister Maya isn't impressed."
  },
  {
   "start": 9.821,
   "end": 17.03,
   "text": "In New York, the fire department just lost almost everyone, because fewer than two percent of its firefighters are women."
  },
  {
   "start": 17.53,
   "end": 24.526,
   "text": "Across America, about ninety-seven percent of electricians are men, so Maya grabs a toolbox and learns fast."
  },
  {
   "start": 25.026,
   "end": 29.268,
   "text": "In Rwanda, a parliament that's already mostly women keeps working."
  },
  {
   "start": 29.768,
   "end": 30.619,
   "text": "And the future?"
  },
  {
   "start": 31.119,
   "end": 36.0,
   "text": "Frozen sperm can last for decades, so new baby boys could arrive within about a year."
  },
  {
   "start": 36.5,
   "end": 38.202,
   "text": "Ray isn't special anymore."
  },
  {
   "start": 38.702,
   "end": 39.753,
   "text": "\"Good,\" Maya says."
  },
  {
   "start": 40.253,
   "end": 41.53,
   "text": "Subscribe for more what-ifs."
  }
 ],
