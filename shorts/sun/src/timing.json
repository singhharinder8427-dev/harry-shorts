 "sentences": [
  {
   "start": 0.4,
   "end": 3.95,
   "text": "If the Sun vanished right now, you wouldn't notice."
  },
  {
   "start": 4.52,
   "end": 10.56,
   "text": "Its light takes eight minutes and twenty seconds to reach us, so the Sun would keep shining in your sky."
  },
  {
   "start": 11.0,
   "end": 16.13,
   "text": "Earth would even keep circling the empty spot, because gravity travels at the speed of light too."
  },
  {
   "start": 17.16,
   "end": 23.849999999999998,
   "text": "Then the sky goes dark, and Earth flies off in a straight line at about thirty kilometers a second."
  },
  {
   "start": 24.34,
   "end": 27.83,
   "text": "Within a week, the average temperature would drop below freezing."
  },
  {
   "start": 28.279999999999998,
   "end": 35.39,
   "text": "The oceans would freeze over on top, but stay liquid underneath for thousands of years, warmed by Earth's own heat."
  },
  {
   "start": 35.74,
   "end": 38.075,
   "text": "Subscribe for more what-ifs like this."
  }
 ],
