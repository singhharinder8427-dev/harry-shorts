 "chunks": [
  {
   "text": "Why does a mosquito",
   "w0": 0,
   "w1": 3,
   "start": 0.4,
   "end": 1.677
  },
  {
   "text": "pick you",
   "w0": 4,
   "w1": 5,
   "start": 1.677,
   "end": 2.102
  },
  {
   "text": "and ignore your friend?",
   "w0": 6,
   "w1": 9,
   "start": 2.102,
   "end": 3.166
  },
  {
   "text": "It isn't luck.",
   "w0": 10,
   "w1": 12,
   "start": 3.666,
   "end": 4.517
  },
  {
   "text": "In one lab test,",
   "w0": 13,
   "w1": 16,
   "start": 5.017,
   "end": 5.868
  },
  {
   "text": "a single volunteer was",
   "w0": 17,
