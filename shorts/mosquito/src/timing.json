 "sentences": [
  {
   "start": 0.4,
   "end": 3.31,
   "text": "Why does a mosquito pick you and ignore your friend?"
  },
  {
   "start": 3.73,
   "end": 4.5600000000000005,
   "text": "It isn't luck."
  },
  {
   "start": 4.96,
   "end": 11.18,
   "text": "In one lab test, a single volunteer was about a hundred times more attractive than the least attractive person."
  },
  {
   "start": 11.71,
   "end": 14.290000000000001,
   "text": "Researchers linked it to fatty acids on the skin."
  },
  {
   "start": 14.75,
   "end": 17.24,
   "text": "Bacteria help turn them into your personal smell."
  },
  {
   "start": 17.75,
   "end": 22.93,
   "text": "Then a 2026 study tested three mosquito species on one hundred nineteen people."
  },
  {
   "start": 23.32,
   "end": 25.029999999999998,
   "text": "Nobody attracted all three."
  },
  {
   "start": 25.45,
   "end": 27.49,
   "text": "Each species wanted a different scent."
  },
  {
   "start": 27.939999999999998,
   "end": 31.45,
   "text": "So being a magnet depends on which mosquito is flying tonight."
  },
  {
   "start": 31.99,
   "end": 34.309999999999995,
   "text": "Subscribe for more strange facts like this."
  }
 ],
