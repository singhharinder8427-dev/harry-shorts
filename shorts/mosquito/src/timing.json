   "start": 15.366,
   "end": 16.855
  },
  {
   "text": "into your personal smell.",
   "w0": 45,
   "w1": 48,
   "start": 16.855,
   "end": 18.345
  },
  {
   "text": "Then a 2026 study tested",
   "w0": 49,
   "w1": 53,
   "start": 18.845,
   "end": 21.185
  },
  {
   "text": "three mosquito species",
   "w0": 54,
   "w1": 56,
   "start": 21.185,
   "end": 22.462
  },
  {
   "text": "on one hundred nineteen people.",
   "w0": 57,
   "w1": 61,
   "start": 22.462,
   "end": 23.951
  },
  {
   "text": "Nobody attracted all three.",
   "w0": 62,
   "w1": 65,
   "start": 24.451,
   "end": 26.153
  },
  {
   "text": "Each species wanted",
   "w0": 66,
   "w1": 68,
   "start": 26.653,
   "end": 27.717
  },
  {
   "text": "a different scent.",
   "w0": 69,
   "w1": 71,
   "start": 27.717,
   "end": 28.781
  },
  {
   "text": "So being a magnet",
   "w0": 72,
