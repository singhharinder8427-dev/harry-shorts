 "sentences": [
  {
   "start": 0.4,
   "end": 2.953,
   "text": "Mia spots a tiny hole in her airplane window."
  },
  {
   "start": 3.453,
   "end": 6.857,
   "text": "Her seatmate Otto is sure it's a manufacturing mistake."
  },
  {
   "start": 7.357,
   "end": 7.996,
   "text": "It isn't."
  },
  {
   "start": 8.496,
   "end": 13.789,
   "text": "Up at cruising height, the air outside is too thin to breathe, so the cabin air is pressurized."
  },
  {
   "start": 14.289,
   "end": 17.894,
   "text": "That pressure pushes outward on every window, the whole flight."
  },
  {
   "start": 18.394,
   "end": 22.423,
   "text": "A window has several panes, and the hole is drilled in the middle one."
  },
  {
   "start": 22.923,
   "end": 27.166,
   "text": "It lets cabin pressure into the gap, so the outer pane carries the load."
  },
  {
   "start": 27.666,
   "end": 30.845,
   "text": "It also lets moisture escape, so the glass doesn't fog."
  },
  {
   "start": 31.345,
   "end": 33.66,
   "text": "Otto leans in, squints, and goes quiet."
  },
  {
   "start": 34.16,
   "end": 34.798,
   "text": "Mia smiles."
  },
  {
   "start": 35.298,
   "end": 36.787,
   "text": "Some mistakes are on purpose."
  },
  {
   "start": 37.287,
   "end": 39.628,
   "text": "Subscribe so you never miss the next strange fact."
  }
 ],
