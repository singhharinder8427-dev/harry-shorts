 "chunks": [
  {
   "text": "Blob and his two neighbours",
   "w0": 0,
   "w1": 4,
   "start": 0.4,
   "end": 1.81
  },
  {
   "text": "lose everything overnight.",
   "w0": 5,
   "w1": 7,
   "start": 1.81,
   "end": 3.5
  },
  {
   "text": "Money, houses, fields.",
   "w0": 8,
   "w1": 10,
   "start": 3.81,
   "end": 5.67
  },
  {
   "text": "All gone.",
   "w0": 11,
   "w1": 12,
   "start": 6.03,
   "end": 6.62
  },
  {
   "text": "Three hungry days later,",
   "w0": 13,
   "w1": 16,
   "start": 7.25,
   "end": 8.65
  },
  {
   "text": "each of them gets one chicken.",
   "w0": 17,
   "w1": 22,
   "start": 8.91,
   "end": 10.39
  },
  {
   "text": "The first neighbour cooks his",
   "w0": 23,
   "w1": 27,
   "start": 10.950000000000001,
   "end": 12.1
  },
  {
   "text": "right away.",
   "w0": 28,
   "w1": 29,
   "start": 12.1,
   "end": 12.790000000000001
  },
  {
   "text": "Best dinner in days.",
   "w0": 30,
   "w1": 33,
   "start": 13.16,
   "end": 14.59
  },
  {
   "text": "Also his last.",
   "w0": 34,
   "w1": 36,
   "start": 15.1,
   "end": 16.099999999999998
  },
  {
   "text": "The second neighbour gets a hen",
   "w0": 37,
   "w1": 42,
   "start": 16.709999999999997,
   "end": 18.185
  },
  {
   "text": "and eats one egg every morning.",
   "w0": 43,
   "w1": 48,
   "start": 18.185,
   "end": 19.91
  },
  {
   "text": "Blob gets a rooster.",
   "w0": 49,
   "w1": 52,
   "start": 20.459999999999997,
   "end": 21.52
  },
  {
   "text": "No eggs at all.",
   "w0": 53,
   "w1": 56,
   "start": 21.889999999999997,
   "end": 22.75
  },
  {
   "text": "So he knocks on her door",
   "w0": 57,
   "w1": 62,
   "start": 23.24,
   "end": 24.445
  },
  {
   "text": "with a deal.",
   "w0": 63,
   "w1": 65,
   "start": 24.445,
   "end": 25.07
  },
  {
   "text": "Let my rooster meet your hen,",
   "w0": 66,
   "w1": 71,
   "start": 25.509999999999998,
   "end": 27.24
  },
  {
   "text": "and I'll share the eggs.",
   "w0": 72,
   "w1": 76,
   "start": 27.41,
   "end": 28.43
  },
  {
   "text": "She wanted eggs.",
   "w0": 77,
   "w1": 79,
   "start": 28.97,
   "end": 29.91
  },
  {
   "text": "Blob wanted chicks.",
   "w0": 80,
   "w1": 82,
   "start": 30.209999999999997,
   "end": 31.43
  },
  {
   "text": "Three weeks later,",
   "w0": 83,
   "w1": 85,
   "start": 32.05,
   "end": 32.86
  },
  {
   "text": "the first chicks hatch.",
   "w0": 86,
   "w1": 89,
   "start": 32.86,
   "end": 34.22
  },
  {
   "text": "About five months after that,",
   "w0": 90,
   "w1": 94,
   "start": 34.57,
   "end": 35.97
  },
  {
   "text": "they're laying eggs too.",
   "w0": 95,
   "w1": 98,
   "start": 36.15,
   "end": 37.15
  },
  {
   "text": "Blob's yard fills up so fast",
   "w0": 99,
   "w1": 104,
   "start": 37.67,
   "end": 39.58
  },
  {
   "text": "he can't keep up,",
   "w0": 105,
   "w1": 108,
   "start": 39.58,
   "end": 40.51
  },
  {
   "text": "so he hires the first neighbour",
   "w0": 109,
   "w1": 114,
   "start": 40.85,
   "end": 42.43
  },
  {
   "text": "and pays him in eggs.",
   "w0": 115,
   "w1": 119,
   "start": 42.43,
   "end": 43.74
  },
  {
   "text": "Same start.",
   "w0": 120,
   "w1": 121,
   "start": 44.23,
   "end": 44.89
  },
  {
   "text": "Same chicken.",
   "w0": 122,
   "w1": 123,
   "start": 45.129999999999995,
   "end": 45.8
  },
  {
   "text": "Now one is poor,",
   "w0": 124,
   "w1": 127,
   "start": 46.23,
   "end": 47.37
  },
  {
   "text": "one is comfortable,",
   "w0": 128,
   "w1": 130,
   "start": 47.589999999999996,
   "end": 48.48
  },
  {
   "text": "and one is rich.",
   "w0": 131,
   "w1": 134,
   "start": 48.72,
   "end": 49.86
  },
  {
   "text": "Subscribe so you don't miss",
   "w0": 135,
   "w1": 139,
   "start": 50.44,
   "end": 51.65
  },
  {
   "text": "Blob's next lesson.",
   "w0": 140,
   "w1": 142,
   "start": 51.65,
   "end": 52.78
  }
 ],
 "sentences": [
  {
   "start": 0.4,
   "end": 3.5,
   "text": "Blob and his two neighbours lose everything overnight."
  },
  {
   "start": 3.81,
   "end": 5.67,
   "text": "Money, houses, fields."
  },
  {
   "start": 6.03,
   "end": 6.62,
   "text": "All gone."
  },
  {
   "start": 7.25,
   "end": 10.39,
   "text": "Three hungry days later, each of them gets one chicken."
  },
  {
   "start": 10.950000000000001,
   "end": 12.790000000000001,
   "text": "The first neighbour cooks his right away."
  },
  {
   "start": 13.16,
   "end": 14.59,
   "text": "Best dinner in days."
  },
  {
   "start": 15.1,
   "end": 16.099999999999998,
   "text": "Also his last."
  },
  {
   "start": 16.709999999999997,
   "end": 19.91,
   "text": "The second neighbour gets a hen and eats one egg every morning."
  },
  {
   "start": 20.459999999999997,
   "end": 21.52,
   "text": "Blob gets a rooster."
  },
  {
   "start": 21.889999999999997,
   "end": 22.75,
   "text": "No eggs at all."
  },
  {
   "start": 23.24,
   "end": 25.07,
   "text": "So he knocks on her door with a deal."
  },
  {
   "start": 25.509999999999998,
   "end": 28.43,
   "text": "Let my rooster meet your hen, and I'll share the eggs."
  },
  {
   "start": 28.97,
   "end": 29.91,
   "text": "She wanted eggs."
  },
  {
   "start": 30.209999999999997,
   "end": 31.43,
   "text": "Blob wanted chicks."
  },
  {
   "start": 32.05,
   "end": 34.22,
   "text": "Three weeks later, the first chicks hatch."
  },
  {
   "start": 34.57,
   "end": 37.15,
   "text": "About five months after that, they're laying eggs too."
  },
  {
   "start": 37.67,
   "end": 43.74,
   "text": "Blob's yard fills up so fast he can't keep up, so he hires the first neighbour and pays him in eggs."
  },
  {
   "start": 44.23,
   "end": 44.89,
   "text": "Same start."
  },
  {
   "start": 45.129999999999995,
   "end": 45.8,
