 "chunks": [
  {
   "text": "Blob and his two neighbours",
   "w0": 0,
   "w1": 4,
   "start": 0.4,
   "end": 1.677
  },
  {
   "text": "lose everything overnight.",
   "w0": 5,
   "w1": 7,
   "start": 1.677,
   "end": 3.166
  },
  {
   "text": "Money, houses, fields.",
   "w0": 8,
   "w1": 10,
   "start": 3.666,
   "end": 5.13
  },
  {
   "text": "All gone.",
   "w0": 11,
   "w1": 12,
   "start": 5.63,
   "end": 6.055
  },
  {
   "text": "Three hungry days later,",
   "w0": 13,
   "w1": 16,
   "start": 6.555,
   "end": 7.832
  },
  {
   "text": "each of them gets one chicken.",
   "w0": 17,
   "w1": 22,
   "start": 8.032,
   "end": 9.521
  },
  {
   "text": "The first neighbour cooks his",
   "w0": 23,
   "w1": 27,
   "start": 10.021,
   "end": 11.298
  },
  {
   "text": "right away.",
   "w0": 28,
   "w1": 29,
   "start": 11.298,
   "end": 11.936
  },
  {
   "text": "Best dinner in days.",
   "w0": 30,
   "w1": 33,
   "start": 12.436,
   "end": 13.5
  },
  {
   "text": "Also his last.",
   "w0": 34,
   "w1": 36,
   "start": 14.0,
   "end": 14.851
  },
  {
   "text": "The second neighbour gets a hen",
   "w0": 37,
   "w1": 42,
   "start": 15.351,
   "end": 17.053
  },
  {
   "text": "and eats one egg every morning.",
   "w0": 43,
   "w1": 48,
   "start": 17.053,
   "end": 18.755
  },
  {
   "text": "Blob gets a rooster.",
   "w0": 49,
   "w1": 52,
   "start": 19.255,
   "end": 20.319
  },
  {
   "text": "No eggs at all.",
   "w0": 53,
   "w1": 56,
   "start": 20.819,
   "end": 21.67
  },
  {
   "text": "So he knocks on her door",
   "w0": 57,
   "w1": 62,
   "start": 22.17,
   "end": 23.447
  },
  {
   "text": "with a deal.",
   "w0": 63,
   "w1": 65,
   "start": 23.447,
   "end": 24.085
  },
  {
   "text": "Let my rooster meet your hen,",
   "w0": 66,
   "w1": 71,
   "start": 24.585,
   "end": 26.074
  },
  {
   "text": "and I'll share the eggs.",
   "w0": 72,
   "w1": 76,
   "start": 26.274,
   "end": 27.338
  },
  {
   "text": "She wanted eggs.",
   "w0": 77,
   "w1": 79,
   "start": 27.838,
   "end": 28.689
  },
  {
   "text": "Blob wanted chicks.",
   "w0": 80,
   "w1": 82,
   "start": 29.189,
   "end": 30.04
  },
  {
   "text": "Three weeks later,",
   "w0": 83,
   "w1": 85,
   "start": 30.54,
   "end": 31.391
  },
  {
   "text": "the first chicks hatch.",
   "w0": 86,
   "w1": 89,
   "start": 31.591,
   "end": 32.443
  },
  {
   "text": "About five months after that,",
   "w0": 90,
   "w1": 94,
   "start": 32.943,
   "end": 34.432
  },
  {
   "text": "they're laying eggs too.",
   "w0": 95,
   "w1": 98,
   "start": 34.632,
   "end": 35.696
  },
  {
   "text": "Blob's yard fills up so fast",
   "w0": 99,
   "w1": 104,
   "start": 36.196,
   "end": 37.472
  },
  {
   "text": "he can't keep up,",
   "w0": 105,
   "w1": 108,
   "start": 37.472,
   "end": 38.323
  },
  {
   "text": "so he hires the first neighbour",
   "w0": 109,
   "w1": 114,
   "start": 38.523,
   "end": 40.226
  },
  {
   "text": "and pays him in eggs.",
   "w0": 115,
   "w1": 119,
   "start": 40.226,
   "end": 41.289
  },
  {
   "text": "Same start.",
   "w0": 120,
   "w1": 121,
   "start": 41.789,
   "end": 42.215
  },
  {
   "text": "Same chicken.",
   "w0": 122,
   "w1": 123,
   "start": 42.715,
   "end": 43.353
  },
  {
   "text": "Now one is poor,",
   "w0": 124,
   "w1": 127,
   "start": 43.853,
   "end": 44.704
  },
  {
   "text": "one is comfortable,",
   "w0": 128,
   "w1": 130,
   "start": 44.904,
   "end": 46.181
  },
  {
   "text": "and one is rich.",
   "w0": 131,
   "w1": 134,
   "start": 46.381,
   "end": 47.232
  },
  {
   "text": "Subscribe so you don't miss",
   "w0": 135,
   "w1": 139,
   "start": 47.732,
   "end": 49.009
  },
  {
   "text": "Blob's next lesson.",
   "w0": 140,
   "w1": 142,
   "start": 49.009,
   "end": 49.86
  }
 ],
 "sentences": [
  {
   "start": 0.4,
   "end": 3.166,
   "text": "Blob and his two neighbours lose everything overnight."
  },
  {
   "start": 3.666,
   "end": 5.13,
   "text": "Money, houses, fields."
  },
  {
   "start": 5.63,
   "end": 6.055,
   "text": "All gone."
  },
  {
   "start": 6.555,
   "end": 9.521,
   "text": "Three hungry days later, each of them gets one chicken."
  },
  {
   "start": 10.021,
   "end": 11.936,
   "text": "The first neighbour cooks his right away."
  },
  {
   "start": 12.436,
   "end": 13.5,
   "text": "Best dinner in days."
  },
  {
   "start": 14.0,
   "end": 14.851,
   "text": "Also his last."
  },
  {
   "start": 15.351,
   "end": 18.755,
   "text": "The second neighbour gets a hen and eats one egg every morning."
  },
  {
   "start": 19.255,
   "end": 20.319,
   "text": "Blob gets a rooster."
  },
  {
   "start": 20.819,
   "end": 21.67,
   "text": "No eggs at all."
  },
  {
   "start": 22.17,
   "end": 24.085,
   "text": "So he knocks on her door with a deal."
  },
  {
   "start": 24.585,
   "end": 27.338,
   "text": "Let my rooster meet your hen, and I'll share the eggs."
  },
  {
   "start": 27.838,
   "end": 28.689,
   "text": "She wanted eggs."
  },
  {
   "start": 29.189,
   "end": 30.04,
   "text": "Blob wanted chicks."
  },
  {
   "start": 30.54,
   "end": 32.443,
   "text": "Three weeks later, the first chicks hatch."
  },
  {
   "start": 32.943,
   "end": 35.696,
   "text": "About five months after that, they're laying eggs too."
  },
  {
   "start": 36.196,
   "end": 41.289,
   "text": "Blob's yard fills up so fast he can't keep up, so he hires the first neighbour and pays him in eggs."
  },
  {
   "start": 41.789,
   "end": 42.215,
   "text": "Same start."
  },
  {
   "start": 42.715,
   "end": 43.353,
   "text": "Same chicken."
  },
  {
