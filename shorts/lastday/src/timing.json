 "sentences": [
  {
   "start": 0.4,
   "end": 2.315,
   "text": "A corrupt boss counts stolen money."
  },
  {
   "start": 2.815,
   "end": 3.879,
   "text": "A thief robs the street."
  },
  {
   "start": 4.379,
   "end": 6.706,
   "text": "And in this story, God has seen enough."
  },
  {
   "start": 7.206,
   "end": 9.76,
   "text": "A rock ten kilometres wide turns toward Earth."
  },
  {
   "start": 10.26,
   "end": 15.566,
   "text": "It falls more than ten kilometres every second, about ten times faster than a bullet."
  },
  {
   "start": 16.066,
   "end": 18.819,
   "text": "From the Moon's distance, under nine hours to impact."
  },
  {
   "start": 19.319,
   "end": 21.021,
   "text": "The boss tries to buy his way out."
  },
  {
   "start": 21.521,
   "end": 22.585,
   "text": "The thief tries to run."
  },
  {
   "start": 23.085,
   "end": 23.723,
   "text": "Neither helps."
  },
  {
   "start": 24.223,
   "end": 33.772,
   "text": "A rock this size once turned the ground to vapour at around five thousand degrees, wrapped the planet in dust within hours, and sent giant waves to most coastlines in two days."
  },
  {
   "start": 34.272,
   "end": 35.762,
   "text": "It ended the dinosaurs."
  },
  {
   "start": 36.262,
   "end": 37.964,
   "text": "But one scientist has a plan."
  },
  {
   "start": 38.464,
   "end": 46.098,
   "text": "In 2022, NASA crashed a spacecraft called DART into an asteroid, and shifted its orbit by thirty-two minutes."
  },
  {
   "start": 46.598,
   "end": 49.351,
   "text": "Find the rock early, and a small push is enough."
  },
  {
   "start": 49.851,
   "end": 51.128,
   "text": "Subscribe for more what-ifs."
  }
 ],
